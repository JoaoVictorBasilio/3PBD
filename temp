CREATE DATABASE Cadastro 
default character set utf8 
default collate utf8_general_ci;

CREATE TABLE Pessoas(
  id_pes not null auto_increment,
  nome varchar(40) not null,
  email varchar(20) not null,
  primary key (id_pes));
  default charset = utf8;
  
  CREATE TABLE Telefones(
    id_tel INT not null auto_increment,
    telefone varchar(13),
    Pessoas_id INT,
    primary key (id_tel),
    foreign key (Pessoas_id) references Pessoas(id_pes));
    
    CREATE TABLE Projetos(
      id_proj not null auto_increment,
      nome varchar(20) not null,
      descricao varchar(40),
      data date,
      primary key (id_proj));
      
      CREATE TABLE Projetos_X_Pessoas(
        id_pxp int not null auto_increment,
        Projetos_id int,
        Pessoas_id int,
        primary key (id_pxp),
        foreign key (Projetos_id) references Projetos(id_proj),
        foreign key (Pessoas_id) references Pessoas (id_pes));
        
